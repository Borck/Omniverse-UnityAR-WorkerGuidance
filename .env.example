# ─── .env template ────────────────────────────────────────────────────────
# Copy this file to `.env` (in the repo root) and replace placeholders with
# values for your environment. The `.env` file is gitignored so each operator
# can keep their own local settings.

# ─── Server endpoints (what the Unity client connects to) ────────────────
# Replace <server-ip> with the IP/hostname of the machine running the
# FastAPI + gRPC servers (e.g. 192.168.1.100, my-server.local, or the AT21
# host name). Use the same IP/hostname you set in AppBootstrap.grpcTarget /
# httpBridgeBaseUrl on the Unity side.
GUIDANCE_HTTP_BASE_URL=http://<server-ip>:8080
GUIDANCE_GRPC_ENDPOINT=<server-ip>:50051

# ─── Bind addresses (what the server listens on) ─────────────────────────
# 0.0.0.0 means "all interfaces" so any device on the network can reach the
# server. Change to 127.0.0.1 if you only want local access.
GUIDANCE_HTTP_HOST=0.0.0.0
GUIDANCE_HTTP_PORT=8080
GUIDANCE_GRPC_HOST=0.0.0.0
GUIDANCE_GRPC_PORT=50051
GUIDANCE_LOG_LEVEL=INFO

# ─── Omniverse Nucleus stage (optional) ──────────────────────────────────
# Master composed USD on Nucleus, used by export_pipeline if it needs to
# open the stage directly. Per-part exports use their own sub-URLs inside
# tools/packaging/export_glbs_from_usd.py. Leave empty if not using Nucleus.
# Format: omniverse://<nucleus-host>/<project-path>/<scene>.usd
GUIDANCE_STAGE_URI=

# ─── Local roots (relative to repo root) ─────────────────────────────────
GUIDANCE_ASSET_ROOT=./shared/samples/assets
GUIDANCE_TARGET_ROOT=./shared/samples/targets
GUIDANCE_EXPORT_ASSET_ROOT=./shared/samples/assets
GUIDANCE_EXPORT_MANIFEST_ROOT=./shared/samples/manifests
GUIDANCE_EXPORT_JOB_STORE_FILE=./server-kit/runtime/export-jobs.json
GUIDANCE_EXPORT_JOB_PROCESSING_MODE=inline
GUIDANCE_EXPORT_JOB_RETENTION_SECONDS=86400
GUIDANCE_EXPORT_WORKER_POLL_SECONDS=1.0
GUIDANCE_SESSION_STORE_FILE=./server-kit/runtime/sessions.json

# ─── Draco mesh compression (optional) ───────────────────────────────────
# Leave disabled for initial glTFast compatibility.
GUIDANCE_DRACO_ENABLED=false
GUIDANCE_DRACO_TOOLCHAIN=gltf-transform
GUIDANCE_DRACO_ENCODER_CMD=
