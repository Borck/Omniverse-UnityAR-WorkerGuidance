# Example secrets file — copy to `.env` and fill in real values.
# `.env` is gitignored; never put real credentials in this committed example.
#
#   cp .env.example .env   (then edit .env)
#
# Which Nucleus is active on boot: "a" or "b".
OMNI_ACTIVE_NUCLEUS=a

# Nucleus A
OMNI_A_NAME=<nucleus-a-name>
OMNI_A_SERVER=omniverse://<nucleus-a-host>
OMNI_A_USER=<username>
OMNI_A_PASS=<password>

# Nucleus B
OMNI_B_NAME=<nucleus-b-name>
OMNI_B_SERVER=omniverse://<nucleus-b-host>
OMNI_B_USER=<username>
OMNI_B_PASS=<password>
