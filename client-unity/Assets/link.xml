<linker>
  <!-- Prevent IL2CPP from stripping types required by Grpc.Net.Client on Android -->
  <assembly fullname="System.Net.Http"    preserve="all" />
  <assembly fullname="System.Net.Sockets" preserve="all" />
  <assembly fullname="Grpc.Net.Client"    preserve="all" />
  <assembly fullname="Grpc.Net.Common"    preserve="all" />
  <assembly fullname="Grpc.Core.Api"      preserve="all" />
  <assembly fullname="Google.Protobuf"    preserve="all" />
  <assembly fullname="glTFast"            preserve="all" />
  <assembly fullname="glTFast.Newtonsoft" preserve="all" />
</linker>
