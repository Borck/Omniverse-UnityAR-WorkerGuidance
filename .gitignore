# Auto-generated by Unity each time the editor opens — never commit
client-unity/*.csproj
client-unity/*.sln
client-unity/*.user
# Built APKs (use CI / release artifacts instead)
client-unity/*.apk
client-unity/*.aab
# Burst compiler debug info
